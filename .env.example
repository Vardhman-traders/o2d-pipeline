# Copy this file to .env and fill in the real values. Never commit .env.
DATABASE_URL=postgresql://user:password@host.render.com/dbname
# Long random string used to sign login tokens (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
# Optional
# DB_POOL_MAX=5
# TOKEN_HOURS=12
# Order photos (Cloudflare R2). Leave unset and the photo boxes simply stay hidden.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
